# Copy to .env and start with: ull-fleet-server --env-file .env
LISTEN_ADDR=0.0.0.0:3000
# Database and release images. Default: ~/.local/share/ull-fleet
# DATA_DIR=/var/lib/ull-fleet

# Password for the web UI and the release API. Without it anyone on the
# network can upload and deploy firmware.
FLEET_ADMIN_PASSWORD=

# Reject uploads not signed by this key (the device checks regardless).
# OTA_PUBLIC_KEY=<64 hex digits from ull-fleet-sign keygen>

# POLL_INTERVAL_S=30
# METRICS_RETENTION_DAYS=30
